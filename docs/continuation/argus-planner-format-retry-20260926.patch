+@pytest.mark.parametrize("thread_id", ["planner-thread", None])
+def test_plan_next_repairs_malformed_role_decision(monkeypatch, thread_id) -> None:
+    malformed = (
+        'ARGUS_ROLE_DECISION={"role":"planner","payload":'
+        '{"project_done":false,"tasks":[]}}}'
+    )
+    assert latest_role_decision(
+        RunnerResult(exit_code=0, agent_messages=[malformed]), "planner"
+    ) is None
+    rejected = parse_planner_text(malformed)
+    assert rejected.error == MISSING_COMPLETION_MARKER_ERROR
+    assert not rejected.project_done
+    assert rejected.new_tasks == []
+
+    class Runner:
+        def __init__(self):
+            self.calls = []
+
+        def run_exec(self, **kwargs):
+            self.calls.append(kwargs)
+            text = (
+                malformed
+                if len(self.calls) == 1 else
+                'ARGUS_ROLE_DECISION={"role":"planner","payload":'
+                '{"project_done":false,"advance_to_stage":"delivery","tasks":['
+                '{"key":"repair","title":"Repair selection timing",'
+                '"objective":"Compare the native completion event timestamp.",'
+                '"scope":"bounded"}]}}'
+            )
+            return RunnerResult(exit_code=0, thread_id=thread_id, agent_messages=[text])
+
+    runner = Runner()
+    monkeypatch.setattr(
+        Planner, "_build_planner_prompt",
+        staticmethod(lambda **kwargs: "original planner prompt"),
+    )
+    verdict = Planner(runner).plan_next(
+        continuous_objective="repair the release consumer",
+        config=PlannerConfig(
+            working_dir="/tmp/project", current_stage="delivery", require_stage_decision=True,
+        ),
+    )
+    assert verdict.error == ""
+    assert [task.key for task in verdict.new_tasks] == ["repair"]
+    assert len(runner.calls) == 2
+    assert runner.calls[1]["resume_thread_id"] is None
+    assert MISSING_COMPLETION_MARKER_ERROR in runner.calls[1]["prompt"]
+    assert malformed in runner.calls[1]["prompt"]
+    assert "Do not use tools or inspect the project again" in runner.calls[1]["prompt"]
+    options = runner.calls[1]["options"]
+    assert options is runner.calls[0]["options"]
+    assert options.sandbox_mode == "read-only"
+    assert options.dangerous_yolo is False
+    assert options.full_auto is False
+
+
+def test_plan_next_reports_malformed_completion_after_bounded_repair(monkeypatch) -> None:
+    monkeypatch.setattr(
+        Planner, "_build_planner_prompt",
+        staticmethod(lambda **kwargs: "original planner prompt"),
+    )
+    malformed = (
+        'ARGUS_ROLE_DECISION={"role":"planner","payload":'
+        '{"project_done":false,"tasks":[]}}}'
+    )
+    for messages in (
+        ["not a decision", "still not a decision"],
+        [malformed, malformed],
+    ):
+        runner = _SequenceRunner(messages)
+        verdict = Planner(runner).plan_next(
+            continuous_objective="repair the release consumer",
+            config=PlannerConfig(working_dir="/tmp/project"),
+        )
+        assert len(runner.calls) == 2
+        assert runner.calls[1]["resume_thread_id"] is None
+        assert "repair exhausted after 1 attempt" in verdict.error
+        assert MISSING_COMPLETION_MARKER_ERROR in verdict.error
+        assert not verdict.project_done
+        assert verdict.new_tasks == []
+        assert verdict.raw_text == "\n\n--- planner repair attempt ---\n\n".join(messages)
+
