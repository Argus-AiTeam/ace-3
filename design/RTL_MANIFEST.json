  },
  "requirement_catalog": [
    {
      "id": "FP16-ADAPT-FORMAT-001",
      "summary": "Each accepted scalar beat carries one IEEE-754 binary16 bit pattern and remains native-AWQ W4A16 compatible.",
      "contract_refs": [
        "/projection_compatibility/data_format",
        "/projection_compatibility/awq_profile"
      ]
    },
    {
      "id": "FP16-ADAPT-DECODE-001",
      "summary": "Finite binary16 values, including subnormals, decode exactly to signed Q40.24.",
      "contract_refs": [
        "/numerical_contract/decode"
      ]
    },
    {
      "id": "FP16-ADAPT-ENCODE-001",
      "summary": "Q24 results convert to binary16 with round-to-nearest, ties-to-even, signed-zero policy, and finite-overflow saturation.",
      "contract_refs": [
        "/numerical_contract/rounding",
        "/numerical_contract/finite_overflow",
        "/numerical_contract/signed_zero"
      ]
    },
    {
      "id": "FP16-ADAPT-EXCEPTION-001",
      "summary": "NaN or infinity marks the affected result or transaction invalid and returns positive zero without saturation.",
      "contract_refs": [
        "/numerical_contract/nonfinite"
      ]
    },
    {
      "id": "FP16-ADAPT-PROTOCOL-001",
      "summary": "State advances only on ready-valid handshakes and output data, index, last, and status remain stable under backpressure.",
      "contract_refs": [
        "/protocol/input",
        "/protocol/output"
      ]
    },
    {
      "id": "FP16-ADAPT-ABORT-001",
      "summary": "Active-low asynchronous reset and active-high synchronous clear abort and clear the current transaction.",
      "contract_refs": [
        "/protocol/reset",
        "/protocol/clear"
      ]
    },
    {
      "id": "FP16-ADAPT-START-001",
      "summary": "Starts are accepted only for legal nonzero counts; RMSNorm requires exactly HIDDEN_SIZE.",
      "contract_refs": [
        "/protocol/start",
        "/protocol/invalid_start"
      ]
    },
    {
      "id": "FP16-ADAPT-RESIDUAL-001",
      "summary": "Residual addition exactly sums projection and residual Q24 values before one binary16 rounding boundary.",
      "contract_refs": [
        "/implementations/residual_add",
        "/numerical_contract/decode",
        "/numerical_contract/rounding",
        "/numerical_contract/nonfinite",
        "/numerical_contract/finite_overflow",
        "/numerical_contract/signed_zero"
      ]
    },
    {
      "id": "FP16-ADAPT-RMSNORM-001",
      "summary": "RMSNorm uses the frozen two-pass Q24/Q48 equation, 92-bit workspace, epsilon, and 46-cycle integer square root.",
      "contract_refs": [
        "/numerical_contract/rmsnorm"
      ]
    },
    {
      "id": "FP16-ADAPT-SILU-001",
      "summary": "SiLU/gate uses the frozen Q0.24 rational sigmoid and exact wide gate product before one Q24 and one binary16 rounding boundary.",
      "contract_refs": [
        "/numerical_contract/silu_gate"
      ]
    },
    {
      "id": "FP16-ADAPT-DIMENSION-001",
      "summary": "Default dimensions are hidden size 896 and MLP intermediate size 4864 while core bounds remain parameterized.",
      "contract_refs": [
        "/projection_compatibility/residual_vector_size",
        "/projection_compatibility/rmsnorm_hidden_size",
        "/projection_compatibility/silu_intermediate_size"
      ]
    },
    {
      "id": "FP16-ADAPT-CYCLE-001",
      "summary": "The declared cycle boundaries are one cycle for residual-add and SiLU/gate and 46 post-load square-root cycles for RMSNorm.",
      "contract_refs": [
        "/cycle_boundaries"
      ]
    },
    {
      "id": "FP16-ADAPT-PROVENANCE-001",
      "summary": "ACE-3 arithmetic is first-party RTL; only the enumerated ACE-2 control, protocol, dataflow, and verification structures are re-expressed.",
      "contract_refs": [
        "/ace2_reuse_audit"
      ]
    }
  ],
